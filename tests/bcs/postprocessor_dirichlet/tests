[Tests]
  [flexible]
    type = Exodiff
    input = 'postprocessor_dirichlet.i'
    exodiff = 'postprocessor_dirichlet_out.e'
    requirement = 'The system shall strongly impose a Dirichlet value taken from a scaled and offset postprocessor.'
  []
  [penalty]
    type = Exodiff
    input = 'postprocessor_dirichlet.i'
    cli_args = 'BCs/left_flexible/enable=false
                BCs/left_penalty/enable=true
                Outputs/file_base=penalty_out'
    exodiff = 'penalty_out.e'
    requirement = 'The system shall weakly impose a postprocessor Dirichlet value through a penalty boundary condition.'
  []
